# ==============================================================================
# Hardware Connection Configuration
# ==============================================================================
# Whether to use virtual mock serial port / simulator if hardware is not plugged in
SIMULATE_HARDWARE=true

# Serial / UART communication
# macOS typical: /dev/cu.usbserial-* or /dev/cu.usbmodem*
# Linux typical: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=/dev/cu.usbserial-0001
SERIAL_BAUD_RATE=115200
SERIAL_TIMEOUT_SEC=1.0

# WiFi / Network settings (if ESP32 / WiFi MCU connects to local network)
WIFI_SSID=
WIFI_PASSWORD=

# MQTT / WebSocket broker (optional for distributed hardware-software telemetry)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=sz-hackathon/device-01

# ==============================================================================
# Host Software & API Services
# ==============================================================================
HOST_API_PORT=8000
HOST_API_HOST=0.0.0.0
WEB_FRONTEND_PORT=3000
LOG_LEVEL=INFO

# ==============================================================================
# AI / Agentic Multimodal Model Keys (if integrating vision, audio, or reasoning)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
MINIMAX_API_KEY=
